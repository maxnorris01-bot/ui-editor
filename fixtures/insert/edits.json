     "text": "</style>",
     "read": "</style>"
    },
    {
     "op": "text",
     "target": "#h10",
     "text": "\"><img src=x onerror=1>",
     "read": "\"><img src=x onerror=1>"
    },
    {
     "op": "text",
     "target": "#h11",
     "text": "&amp;",
     "read": "&amp;"
    },
    {
     "op": "text",
     "target": "#h12",
     "text": "Привет 你好 مرحبا 🎉",
     "read": "Привет 你好 مرحبا 🎉"
    },
    {
     "op": "text",
     "target": "#h13",
     "text": {
      "repeat": "abcdefghi ",
