{
 "version": 1,
 "header": "Exported from UI Editor. Comments starting \"NOTE FOR AI:\" are the designer's instructions for the element that follows. Implement them.",
 "tolerance": {
  "px": 0.5,
  "bboxPx": 1
 },
 "viewportHeight": 800,
 "specs": [
  {
   "id": "I01",
   "title": "insert a text paragraph after the lead paragraph; rule goes to the companion CSS",
   "fixture": "landing.html",
   "steps": [
    {
     "op": "insert",
     "kind": "text",
     "anchor": ".lead",
     "placement": "after"
    }
   ],
   "expect": {
    "outcome": "PASS",
    "format": "lines",
    "bytes": "additive",
    "created": [
     {
      "selector": ".new-text-1",
      "tag": "p",
      "parent": ".hero-copy",
      "index": 2,
      "text": "Text"
     }
    ],
    "ruleIn": "landing.css",
    "cls": "new-text-1"
   }
  },
  {
   "id": "I02",
