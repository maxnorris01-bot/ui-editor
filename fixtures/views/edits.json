   "id": "M01",
   "title": "Desktop font-size 32 to 48: Tablet follows (48), the page's own Phone value 20 scales to 30",
   "fixture": "bp640.html",
   "steps": [
    {
     "op": "set",
     "target": "#title",
     "properties": {
      "font-size": "48px"
     },
     "environment": "desktop"
    }
   ],
   "expect": {
    "outcome": "PASS",
    "measured": [
     {
      "sel": "#title",
      "prop": "font-size",
      "desktop": "48px",
      "tablet": "48px",
      "phone": "30px"
     }
    ],
    "legit": "flow"
