      "selector": "#h1",
      "text": "-->"
     },
     {
      "selector": "#h2",
      "text": "--"
     },
     {
      "selector": "#h3",
      "text": "--!>"
     },
     {
      "selector": "#h4",
      "text": "<!--"
     },
     {
      "selector": "#h5",
      "text": "> starts with a greater-than"
     },
     {
      "selector": "#h6",
      "text": "-> starts with an arrow"
     },
     {
      "selector": "#h7",
      "text": "ends with a hyphen-"
     },
     {
      "selector": "#h8",
      "text": "<script>alert(1)</script>"
     },
     {
      "selector": "#h9",
      "text": "</style>"
     },
     {
      "selector": "#h10",
      "text": "\"><img src=x onerror=1>"
     },
     {
      "selector": "#h11",
      "text": "&amp;"
     },
     {
